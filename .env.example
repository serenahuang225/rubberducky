# Preparation only. No credentials are supplied; live integrations stay disabled.
TUTOR_PROVIDER=mock
EXTERNAL_INTEGRATIONS_ENABLED=false
DATABASE_URL=sqlite:///./data/tutor.db

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Required when the key is not scoped to one workspace. Copy the wrkspc_ id from the console.
ANTHROPIC_WORKSPACE_ID=

# Application-side test budget, not a provider-enforced spending limit.
ANTHROPIC_TEST_BUDGET_USD=5

# Tutor provider selection: mock (default), transformers, endpoint or claude. See README.
# Local model loading is opt-in, CPU by default and cache-only unless download is allowed.
TUTOR_LOCAL_MODEL_LOAD_ENABLED=false
TUTOR_LOCAL_ALLOW_DOWNLOAD=false
# OpenAI-compatible endpoint (also needs EXTERNAL_INTEGRATIONS_ENABLED=true).
TUTOR_ENDPOINT_BASE_URL=
TUTOR_ENDPOINT_MODEL=
TUTOR_ENDPOINT_API_KEY=

# Factory droid-sdk also supports an authenticated local Droid CLI.
FACTORY_API_KEY=

DAYTONA_API_KEY=
# Optional endpoint override; validate the host before attaching credentials.
DAYTONA_API_URL=

# chalkcompute[sql] provides Evaluation and DatasetClient without chalkpy.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=
# Optional tenant API endpoint; SDK default is https://api.chalk.ai.
CHALK_API_SERVER=

# Photon product selection is BLOCKED: Stable and Beta credentials differ.
# These requested placeholders are not automatically consumed by both SDKs.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Stable Spectrum automatically reads these, or accepts explicit constructor args.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Beta photonhq-api README uses this name; pass as Authorization: Bearer explicitly.
# Beta project IDs begin pho_prj_; never mix Beta credentials with Stable hosts.
PHOTON_API_TOKEN=

# LiveKit voice remains disabled; live verification is deferred.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_ENABLED=false

# Hold-to-talk on the whiteboard. Off unless BOTH flags are true and the key is set.
# The recording goes to xAI speech-to-text. The transcript goes through the tutor
# (Claude, when TUTOR_PROVIDER=claude). xAI text-to-speech speaks only that reply.
# The key stays on this server. Photon messaging is a separate channel.
XAI_API_KEY=
XAI_SPEECH_ENABLED=false
XAI_STT_MODEL=grok-voice-transcribe-2.0
XAI_TTS_VOICE=luna
XAI_TTS_LANGUAGE=en
